PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-64-byte-random-access-secret
JWT_REFRESH_SECRET=replace-with-64-byte-random-refresh-secret
JWT_REFRESH_EXPIRES_DAYS=7

# Supabase PostgreSQL (Drizzle ORM)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Google OAuth 2.0 (Customers Only)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Email OTP Delivery (Optional in dev — falls back to terminal log)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pet Mall <no-reply@petmall.com>
